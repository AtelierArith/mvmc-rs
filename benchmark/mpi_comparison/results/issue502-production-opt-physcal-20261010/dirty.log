@@ -289,6 +297,56 @@ mod lifecycle_tests {
     use super::*;
     use crate::observables::clear_phys_quantity;
 
+    #[test]
+    fn large_ordered_merge_preserves_cancellation_and_chunk_tails() {
+        crate::threading::install(|| {
+            // Nonmultiples of 1024 exercise the last window. The three locals
+            // must be added in order: (1e16 - 1e16) + 1 is 1, not 0.
+            let mut destination = SROptData::zeros(257, 5, false);
+            let locals: Vec<_> = [1e16, -1e16, 1.0]
+                .into_iter()
+                .map(|value| {
+                    let mut local = SrAccumulator::zeros_like(&destination);
+                    for values in [
+                        &mut local.buffers.sr_opt_oo,
+                        &mut local.buffers.sr_opt_ho,
+                        &mut local.buffers.sr_opt_o_store,
+                    ] {
+                        values.fill(Complex64::new(value, -value));
+                    }
+                    for values in [
+                        &mut local.buffers.sr_opt_oo_real,
+                        &mut local.buffers.sr_opt_ho_real,
+                        &mut local.buffers.sr_opt_o_store_real,
+                    ] {
+                        values.fill(value);
+                    }
+                    local
+                })
+                .collect();
+            merge_sr_locals(&mut destination, &locals).unwrap();
+            for values in [
+                &destination.sr_opt_oo,
+                &destination.sr_opt_ho,
+                &destination.sr_opt_o_store,
+            ] {
+                assert!(values
+                    .iter()
+                    .all(|v| (*v - Complex64::new(1.0, -1.0)).norm() <= f64::EPSILON));
+            }
+            for values in [
+                &destination.sr_opt_oo_real,
+                &destination.sr_opt_ho_real,
+                &destination.sr_opt_o_store_real,
+            ] {
+                assert!(values.iter().all(|v| (*v - 1.0).abs() <= f64::EPSILON));
+            }
+            let mut local = SrAccumulator::from_buffers(destination);
+            local.clear();
+            assert_eq!(local.buffers, SROptData::zeros(257, 5, false));
+        });
+    }
+
     fn state() -> VmcOptimizationState {
         VmcOptimizationState::zeros(2, 1, 0, 2, 1, 3, false, false)
     }
