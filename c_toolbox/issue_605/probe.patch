+/* issue #181 probe: print draw count and the next 624 outputs without
+ * disturbing the generator (state, index and count are saved and restored). */
+#include <stdio.h>
+#include <string.h>
+void mvmc_dump_rng(FILE *fp) {
+    w128_t save[N];
+    int save_idx = idx;
+    unsigned long long save_count = mvmc_draw_count;
+    int i;
+    memcpy(save, sfmt, sizeof(sfmt));
+    fprintf(fp, "draws %llu\nnext624", save_count);
+    for (i = 0; i < 624; i++) fprintf(fp, " %u", gen_rand32());
+    fprintf(fp, "\n");
+    memcpy(sfmt, save, sizeof(sfmt));
+    idx = save_idx;
+    mvmc_draw_count = save_count;
+}
