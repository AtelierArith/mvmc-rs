+extern void mvmc_dump_rng(FILE *fp);
+/* issue #181 probe: saved configurations, counters and RNG after each sample */
+static void mvmc_dump_state(int ismp) {
+  char name[64];
+  int i, n;
+  FILE *fp;
+  snprintf(name, sizeof(name), "state_dump_%03d.txt", ismp);
+  fp = fopen(name, "w");
+  fprintf(fp, "ele_idx");
+  for (i = 0; i < NVMCSample * Nsize; i++) fprintf(fp, " %d", EleIdx[i]);
+  fprintf(fp, "\nele_cfg");
+  for (i = 0; i < NVMCSample * Nsite2; i++) fprintf(fp, " %d", EleCfg[i]);
+  fprintf(fp, "\nele_num");
+  for (i = 0; i < NVMCSample * Nsite2; i++) fprintf(fp, " %d", EleNum[i]);
+  fprintf(fp, "\nele_proj_cnt");
+  for (i = 0; i < NVMCSample * NProj; i++) fprintf(fp, " %d", EleProjCnt[i]);
+  fprintf(fp, "\nele_spn");
+  if (iFlgOrbitalGeneral != 0)
+    for (i = 0; i < NVMCSample * Nsize; i++) fprintf(fp, " %d", EleSpn[i]);
+  fprintf(fp, "\ncounter");
+  for (i = 0; i < Counter_max; i++) fprintf(fp, " %d", Counter[i]);
+  fprintf(fp, "\n");
+  mvmc_dump_rng(fp);
+  fclose(fp);
+}
