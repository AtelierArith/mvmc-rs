{
  "name": "mVMC Rust (Linux x86_64)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "options": [
      "--platform=linux/amd64"
    ]
  },
  "runArgs": [
    "--platform=linux/amd64"
  ],
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "mounts": [
    "source=mvmc-cargo-${devcontainerId},target=/home/vscode/.cargo,type=volume",
    "source=mvmc-linux-cache-${devcontainerId},target=/home/vscode/.cache/mvmc,type=volume",
    "source=${localWorkspaceFolder}/.devcontainer/cargo-config.toml,target=${containerWorkspaceFolder}/.cargo/config.toml,type=bind,readonly"
  ],
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "julialang.language-julia",
        "ms-toolsai.jupyter",
        "ms-python.python",
        "mhutchie.git-graph",
        "congyiwu.vscode-jupytext",
        "charliermarsh.ruff",
        "wdawson.better-kill-ring",
        "ms-vscode.cpptools",
        "twxs.cmake",
        "ms-vscode.cmake-tools"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy"
      }
    }
  },
  "forwardPorts": [
    1234,
    8000,
    8080,
    8888
  ]
}
